{
  "name": "explore-atlas-web",
  "private": true,
  "version": "1.0.0",
  "engines": {
    "node": ">=22 <25"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch --env-file=.env server/index.ts",
    "dev:all": "concurrently -n web,api -c blue,green \"npm run dev\" \"npm run dev:api\"",
    "build": "tsc -b && vite build",
    "build:api": "tsc -p tsconfig.server.json",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "test": "node --import tsx src/lib/analyticsDisplay.test.ts && node --import tsx src/features/admin/observability/adminMetricsFormat.test.ts && node --import tsx src/pages/admin/apiDocsSecurity.test.ts && node --import tsx src/features/share/lib/formatRoutePreview.test.ts && node src/features/pioneers/api/pioneersApi.test.mjs && node server/api-lib/pioneers/pioneersService.test.mjs && node server/api-lib/analytics/analyticsRouter.source.test.mjs && node server/api-lib/analytics/analyticsAdminApi.test.mjs && node server/api-lib/analytics/analyticsOperationsService.test.mjs && node server/api-lib/analytics/businessInsightsService.test.mjs && node --test src/app/adminDashboardV2.source.test.mjs netlify/functions/lib/verifyAdmin.test.mjs scripts/business-geo-enrichment.test.mjs scripts/lint-openapi-surfaces.test.mjs server/api-lib/analytics/businessAccess.test.mjs server/api-lib/analytics/businessEventToInsightE2E.test.mjs server/api-lib/analytics/businessGoldenDataset.test.mjs server/api-lib/analytics/businessIntelligenceService.test.mjs server/api-lib/analytics/businessProductionMigration.test.mjs server/api-lib/docs/docsRouter.source.test.mjs server/api-lib/docs/postgrestOpenApi.test.mjs server/api-lib/docs/openapi.admin.antiDrift.test.mjs server/api-lib/docs/edgeOpenApi.spec.test.mjs server/api-lib/intelligence/intelligenceReports.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots=all",
    "test:e2e:perf": "playwright test --config playwright.performance.config.ts",
    "report:bundle": "node scripts/report-bundle-sizes.mjs dist",
    "reports:samples": "node scripts/generate-intelligence-report-samples.mjs",
    "openapi:lint": "node scripts/lint-openapi-surfaces.mjs",
    "openapi:preview": "redocly preview-docs server/api-lib/docs/openapi.admin.yaml",
    "openapi:sync-edge": "node scripts/sync-edge-openapi.mjs",
    "verify:shared-migration-history": "node scripts/verify-shared-migration-history.mjs",
    "verify:business-schema": "node --env-file-if-exists=.env.local scripts/verify-business-schema.mjs",
    "business:backfill": "node --env-file-if-exists=.env.local scripts/business-backfill.mjs",
    "business:enrich-geo": "node --env-file-if-exists=.env.local scripts/business-enrich-geo.mjs",
    "business:provision-identities": "node --env-file-if-exists=.env.local scripts/business-provision-controlled-identities.mjs",
    "business:provision-pilot": "node --env-file-if-exists=.env.local --env-file-if-exists=.tmp/bi-qa.env scripts/business-provision-pilot.mjs",
    "business:audit": "node --env-file-if-exists=.env.local scripts/business-data-quality-audit.mjs",
    "analytics:ingestion-audit": "node --env-file-if-exists=.env.local scripts/analytics-ingestion-audit.mjs",
    "analytics:executive-reconcile": "node --env-file-if-exists=.env.local scripts/admin-executive-reconcile.mjs",
    "business:fingerprint": "node --env-file-if-exists=.env.local scripts/business-fact-fingerprint.mjs",
    "business:production-smoke": "node --env-file-if-exists=.env.local --env-file-if-exists=.tmp/bi-qa.env scripts/business-production-smoke.mjs",
    "business:cron-smoke": "node --env-file-if-exists=.env.local --env-file-if-exists=.tmp/bi-qa.env scripts/business-cron-production-smoke.mjs",
    "verify:browser-secrets": "node scripts/browser-secret-audit.mjs",
    "obs:up": "docker compose -f observability/docker-compose.observability.yml up -d",
    "obs:down": "docker compose -f observability/docker-compose.observability.yml down",
    "obs:logs": "docker compose -f observability/docker-compose.observability.yml logs -f grafana prometheus loki",
    "obs:ps": "docker compose -f observability/docker-compose.observability.yml ps",
    "obs:smoke": "node scripts/obs-smoke.mjs",
    "obs:ready": "npm run obs:up && node scripts/obs-smoke.mjs --wait",
    "waitlist:notify": "tsx server/scripts/notify-launch.ts",
    "waitlist:notify:dry": "tsx server/scripts/notify-launch.ts -- --dry-run",
    "email:test": "tsx server/scripts/send-test-email.ts",
    "email:launch:test": "tsx server/scripts/send-launch-test-email.ts",
    "dev:mail": "docker compose up -d mailpit",
    "netlify:env": "powershell -ExecutionPolicy Bypass -File scripts/crear-netlify-env.ps1",
    "resend:check": "node scripts/check-resend-domain.mjs",
    "admin:provision": "node scripts/provision-supabase-admins.mjs",
    "admin:bootstrap": "node scripts/run-board-admin-bootstrap.mjs",
    "vercel:env": "powershell -ExecutionPolicy Bypass -File scripts/crear-vercel-env.ps1",
    "env:from-prod": "vercel env run -e production -- node scripts/write-prod-env.mjs"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.19",
    "@netlify/blobs": "^8.1.0",
    "@scalar/api-reference-react": "^0.9.61",
    "@supabase/supabase-js": "^2.108.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^2.2.13",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "firebase": "^13.0.0",
    "firebase-admin": "^13.10.0",
    "leaflet": "^1.9.4",
    "motion": "^12.42.2",
    "nodemailer": "^10.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.1.1",
    "react-use-measure": "^2.1.7",
    "recharts": "^3.9.2",
    "swagger2openapi": "^7.0.8",
    "tailwind-merge": "^3.6.0",
    "ws": "^8.21.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@redocly/cli": "^2.62.1",
    "@tailwindcss/vite": "^4.3.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.2",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  },
  "overrides": {
    "@ai-sdk/provider-utils": "4.0.33",
    "@firebase/firestore": {
      "@grpc/grpc-js": "1.14.6"
    }
  }
}
