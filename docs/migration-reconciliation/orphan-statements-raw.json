        "-- Returns the exact place/photo fields needed by dry-run duplicate and image\n-- auditing. Keeping geography extraction server-side avoids assuming how\n-- PostgREST serializes PostGIS values.\nCREATE OR REPLACE FUNCTION public.production_seed_place_inventory()\nRETURNS TABLE (\n  id UUID,\n  name TEXT,\n  description TEXT,\n  category TEXT,\n  state TEXT,\n  moderation_status TEXT,\n  lat DOUBLE PRECISION,\n  lng DOUBLE PRECISION,\n  created_by UUID,\n  photos JSONB\n)\nLANGUAGE sql\nSTABLE\nSECURITY DEFINER\nSET search_path = public\nAS $$\n  SELECT\n    p.id,\n    p.name,\n    p.description,\n    p.category::text,\n    p.state::text,\n    p.moderation_status,\n    ST_Y(p.location::geometry) AS lat,\n    ST_X(p.location::geometry) AS lng,\n    p.created_by,\n    COALESCE(\n      jsonb_agg(\n        jsonb_build_object(\n          'id', pp.id,\n          'url', pp.url,\n          'position', pp.position\n        ) ORDER BY pp.position, pp.created_at\n      ) FILTER (WHERE pp.id IS NOT NULL),\n      '[]'::jsonb\n    ) AS photos\n  FROM public.places p\n  LEFT JOIN public.place_photos pp ON pp.place_id = p.id\n  GROUP BY p.id;\n$$",
        "REVOKE ALL ON FUNCTION public.production_seed_place_inventory() FROM PUBLIC, anon, authenticated",
        "GRANT EXECUTE ON FUNCTION public.production_seed_place_inventory() TO service_role"
